# ============================================================
# SAIF TRADING CO — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Base Site URL (used for canonical URLs, sitemaps, and OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase Configuration (Client & Server Public Context)
# ------------------------------------------------------------
# Retrieve from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternate publishable key alias (if applicable in newer Supabase projects)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------
# Supabase Privileged Key (STRICT SERVER-ONLY)
# ------------------------------------------------------------
# NEVER prefix with NEXT_PUBLIC_* or expose to browser/client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# Verified Business Channels (Hong Kong Office)
# ------------------------------------------------------------
NEXT_PUBLIC_OFFICE_TEL=+85235251640
NEXT_PUBLIC_MOBILE_1=+85290649593
NEXT_PUBLIC_MOBILE_2=+85269037690
NEXT_PUBLIC_CONTACT_EMAIL=Saiftradingco@yahoo.com

# ------------------------------------------------------------
# Google Search Console Verification (Optional)
# ------------------------------------------------------------
# Paste verification token from Google Search Console HTML tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

